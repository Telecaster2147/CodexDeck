$background: #0f172a;
$surface: #111827;
$surface-light: #1f2937;
$border: #334155;
$text: #f8fafc;
$muted: #94a3b8;
$accent: #38bdf8;
$success: #4ade80;
$warning: #fbbf24;
$error: #f87171;

Screen {
    background: $background;
    color: $text;
}

#app-header {
    height: 1;
    padding: 0 2;
    background: #111827;
}

#workspace {
    height: 1fr;
    padding: 0 1;
}

#navigation {
    width: 42;
    min-width: 34;
    height: 1fr;
    border-right: solid $border;
    padding-right: 1;
}

#search {
    height: 3;
    margin-bottom: 1;
    border: tall $accent;
    background: $surface;
}

#search.settled {
    display: none;
}

#session-list {
    height: 1fr;
    background: transparent;
    scrollbar-size: 1 1;
}

#session-list > ListItem {
    height: auto;
    min-height: 2;
    padding: 0 1;
    margin-bottom: 0;
    background: transparent;
    border-left: thick transparent;
}

#session-list > ListItem.-highlight {
    background: $surface-light;
    border-left: thick $accent;
    color: $text;
}

#session-list:focus > ListItem.-highlight {
    background: $surface-light;
    border-left: thick $accent;
    color: $text;
    text-style: none;
}

#session-list > .workspace-row {
    margin-top: 1;
    min-height: 2;
    color: $text;
}

#session-list > .session-row {
    min-height: 2;
}

#session-list > .aux-row {
    color: $muted;
}

#inspector {
    width: 1fr;
    height: 1fr;
    padding-left: 2;
}

#session-title {
    height: 3;
    padding: 1 1 0 1;
    background: $surface;
    border-bottom: solid $border;
}

#health-strip {
    height: 2;
    padding: 0 1;
    color: $muted;
    background: $surface;
}

#detail-tabs {
    height: 2;
    background: $background;
    border-bottom: solid $border;
}

#detail-tabs Tab.-active {
    color: $accent;
    background: transparent;
    text-style: bold;
}

#detail-content {
    height: 1fr;
    background: $background;
}

#activity-panel,
#diagnosis-panel {
    height: 1fr;
    padding: 1;
    background: $background;
    scrollbar-size: 1 1;
}

#activity-panel {
    overflow-x: hidden;
    overflow-y: auto;
}

#status-line {
    height: 1;
    padding: 0 2;
    color: $muted;
    background: $surface;
}

Footer {
    height: 1;
    background: #111827;
    color: $muted;
}

#too-small {
    display: none;
    width: 100%;
    height: 1fr;
    content-align: center middle;
    text-align: center;
    color: $warning;
}

.compact #navigation {
    width: 100%;
    min-width: 1;
    border-right: none;
    padding-right: 0;
}

.compact #inspector {
    display: none;
    padding-left: 0;
}

.compact.detail-open #navigation {
    display: none;
}

.compact.detail-open #inspector {
    display: block;
    width: 100%;
}

.too-small #workspace,
.too-small #status-line {
    display: none;
}

.too-small #too-small {
    display: block;
}

HelpScreen,
SettingsScreen {
    align: center middle;
    background: #020617 65%;
}

#help-dialog,
#settings-dialog {
    width: 76;
    max-width: 92%;
    height: auto;
    max-height: 90%;
    padding: 1 2;
    background: $surface;
    border: round $border;
}

#settings-dialog {
    width: 72;
    height: 17;
    max-height: 92%;
}

#settings-fields {
    height: 1fr;
    scrollbar-size: 1 1;
}

.setting-row {
    height: 3;
    padding: 0 1;
    background: transparent;
}

.setting-row:hover {
    background: $surface-light;
}

.setting-label {
    width: 1fr;
    height: 3;
    content-align: left middle;
}

.setting-row Switch {
    width: auto;
    height: 3;
}

.setting-row Select {
    width: 38;
    height: 3;
}

#settings-actions {
    height: 4;
    align-horizontal: right;
    padding-top: 1;
}

#settings-actions Button {
    width: 12;
    min-width: 10;
    margin-left: 1;
}

#compare-dialog {
    width: 110;
    height: 80%;
}

#dialog-title {
    height: 2;
    color: $accent;
    text-style: bold;
}

#compare-table {
    height: 1fr;
    background: $surface;
    scrollbar-size: 1 1;
}

.dialog-hint {
    height: 2;
    padding-top: 1;
    color: $muted;
    text-align: right;
}
