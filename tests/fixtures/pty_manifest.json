      "expected_terminal_identity",
      "expected_state",
      "actual_state",
      "visibility_result",
      "domain_correctness_result",
      "valid"
    ],
    "invalid_when": [
      "fixture_id_missing",
      "input_or_snapshot_missing",
      "expected_and_actual_conflict",
      "terminal_dimensions_missing",
      "observation_time_missing"
    ]
  },
